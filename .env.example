# Copy this file to .env and fill in ONE of the two options below.
# Never commit the real .env file (it is already in .gitignore).

# ---------------------------------------------------------------
# OPTION A (simplest for Career Day): a free Gemini API key.
# Get one at https://aistudio.google.com/apikey
# ---------------------------------------------------------------
GEMINI_API_KEY=paste-your-key-here

# ---------------------------------------------------------------
# OPTION B (Cloud Architect mode): use Gemini through Vertex AI in
# your own Google Cloud project. No API key is needed; sign in once with
#   gcloud auth application-default login
# Then comment out GEMINI_API_KEY above and uncomment these three lines.
# ---------------------------------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# ---------------------------------------------------------------
# OPTIONAL: Google Cloud Text-to-Speech for the "Read Aloud" button.
# Requires:  pip install -e ".[tts]"   and Option B credentials (ADC)
# with the Cloud Text-to-Speech API enabled in the project.
# Leave false to use the browser's built-in voice (zero setup).
# ---------------------------------------------------------------
ENABLE_CLOUD_TTS=false
# Youthful male voices by default (the badger is a kid). Spanish is es-US,
# Latin American. Pitch is in semitones; 0 is the voice's natural pitch.
# CLOUD_TTS_VOICE=en-US-Neural2-D
# CLOUD_TTS_VOICE_ES=es-US-Neural2-B
# CLOUD_TTS_PITCH=3.0
# CLOUD_TTS_RATE=1.05

# OPTIONAL: send traces/logs to Google Cloud (needs Option B credentials).
# OTEL_TO_CLOUD=false
